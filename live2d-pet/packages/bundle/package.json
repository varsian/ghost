{
  "name": "@local/dsh-live2d-bundle",
  "version": "0.1.0",
  "private": true,
  "description": "Live2D desktop mascot for DeepSeek Harness: a transparent avatar overlay driven by the local TTS plugin's real playback envelope, emotions and text.",
