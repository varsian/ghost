  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/*.json"
  ],
  "license": "Apache-2.0",
  "dependencies": {
    "@local/dsh-live2d": "0.1.0"
  },
  "dsh": {
